# All defaults run locally without API keys. Copying this file is optional.
# Reserved for a future SERVER-SIDE model adapter. Never use VITE_ for secrets.
MODEL_PROVIDER=mock
MODEL_API_KEY=

# Reserved legacy setting; the existing storefront store remains SQLite.
DATABASE_URL=

# Experiment evidence only. Separate from the storefront's DATABASE_URL.
# Paste the hosted Tiger Data PostgreSQL URL into ignored .env.
# TLS required. Use sslmode=verify-full&sslrootcert=/path/to/ca.pem for CA verification.
TIGER_DATABASE_URL=
