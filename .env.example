# All defaults run locally without API keys. Copying this file is optional.
# Reserved for a future SERVER-SIDE model adapter. Never use VITE_ for secrets.
MODEL_PROVIDER=mock
MODEL_API_KEY=

# Optional Tiger Cloud connection for future server-side PostgreSQL integration.
# The current Go API uses SQLite and does not read DATABASE_URL or load .env.
# See docs/tiger-cloud.md. Never prefix a database secret with VITE_.
DATABASE_URL=
