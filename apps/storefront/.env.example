# Public deployment settings; NEVER put credentials in VITE_ variables.
# Default unset = no automatic telemetry, no uploads, no recorder load.
# Production uses a production build, HTTPS, and exact non-local hostname(s).
# VITE_SHOP_TELEMETRY=production
# VITE_SHOP_TELEMETRY_HOSTS=shop.example.com
# VITE_SHOP_TELEMETRY_API_ORIGIN=https://api.example.com
# Consent defaults required. Use notice only for a deployment cleared for opt-out.
# VITE_SHOP_TELEMETRY_CONSENT=required
# VITE_SHOP_MODEL_VERSION=approved-model-artifact-version
# Synthetic integration tests use explicitly isolated localhost + backend config:
# VITE_SHOP_TELEMETRY=synthetic
# VITE_SHOP_TELEMETRY_HOSTS=127.0.0.1
# VITE_SHOP_TELEMETRY_ENVIRONMENT=test
# VITE_SHOP_TELEMETRY_API_ORIGIN=http://127.0.0.1:4330
