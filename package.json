{
  "name": "storefront-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:personalized": "node scripts/dev-personalized.mjs --run",
    "dev:personalized:demo": "node scripts/dev-personalized-factorized.mjs --run --receipt data/ranker/pretrained/persona-factorized-development-admission-v4-attempt-1/receipt.json --receipt-sha256 a8681bd3a57b621540eac0786b183a8dfffa2fc0ebd8f36ed40359ece16e4928",
    "dev:personalized:warm": "node scripts/dev-personalized-preencoded.mjs --run --receipt data/ranker/pretrained/persona-preencoded-development-admission-v3-attempt-1/receipt.json --receipt-sha256 af33c1ff447835bcc63e0132b97dbe3b334936beb2136aea9741369e7f66a2cf",
    "dev:personalized:uncached": "node scripts/dev-personalized-development.mjs --run --receipt data/ranker/pretrained/persona-development-admission-v1-attempt-1/receipt.json --receipt-sha256 d774bc8e0e5dcd09bee705c4658817e07703201bd72888dc4577c94d3b12fa58",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:smoke": "playwright test",
    "seed": "pnpm --filter @storefront/api seed",
    "reset": "pnpm --filter @storefront/api reset",
    "check": "vp check",
    "typecheck:tsc-ts": "node scripts/check-tsc-ts.mjs",
    "ranker:setup": "node scripts/ranker.mjs setup",
    "ranker:data": "node scripts/ranker.mjs data",
    "ranker:train": "node scripts/ranker.mjs train",
    "ranker:evaluate": "node scripts/ranker.mjs evaluate",
    "ranker:infer": "node scripts/ranker.mjs infer",
    "ranker:serve": "node scripts/ranker.mjs serve",
    "ranker:benchmark": "node scripts/ranker.mjs benchmark",
    "ranker:test": "node scripts/ranker.mjs test",
    "pretrained:setup": "node scripts/pretrained.mjs setup",
    "pretrained:data": "node scripts/pretrained.mjs data",
    "pretrained:test": "node scripts/pretrained.mjs test",
    "pretrained:download": "node scripts/pretrained.mjs download",
    "pretrained:verify": "node scripts/pretrained.mjs verify",
    "pretrained:smoke": "node scripts/pretrained.mjs smoke",
    "pretrained:workflow": "node scripts/pretrained.mjs workflow",
    "pretrained:infer": "node scripts/pretrained.mjs infer",
    "pretrained:test:mlx": "node scripts/pretrained.mjs test-mlx",
    "pretrained:fusion": "node scripts/pretrained.mjs fusion",
    "pretrained:test:fusion": "node scripts/pretrained.mjs test-fusion",
    "pretrained:benchmark:fusion": "node scripts/pretrained.mjs fusion-benchmark",
    "pretrained:route:train": "node scripts/pretrained.mjs route-train",
    "pretrained:route:benchmark": "node scripts/pretrained.mjs route-benchmark",
    "pretrained:test:routing": "node scripts/pretrained.mjs test-routing"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "portless": "0.15.8",
    "tsc-ts": "0.0.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
